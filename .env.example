# ---- Picnic ----
PICNIC_USERNAME=jouw@email.nl
PICNIC_PASSWORD=jouw-picnic-wachtwoord
PICNIC_COUNTRY_CODE=NL
# Wordt automatisch ingevuld na de eenmalige login (python -m src.login_setup).
# Zolang deze geldig is hoef je niet opnieuw met 2FA in te loggen.
PICNIC_AUTH_TOKEN=

# ---- AI: Codex (ChatGPT-login of API-key) of Anthropic (Claude API) ----
# Kies de provider in het dashboard; de keuze wordt opgeslagen in config.yaml.
# Leeg = standaardmodel van Codex. Geen API-key nodig.
CODEX_MODEL=
# Optioneel: API-key heeft voorrang op je ChatGPT-login. Geen voorafgaande validatie.
CODEX_API_KEY=
# Nodig voor plannen met Claude; instellen via dit bestand.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Telegram ----
# Maak een bot via @BotFather -> /newbot -> kopieer de token.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Jouw eigen Telegram user-id (via @userinfobot). Alleen deze id mag de bot bedienen.
TELEGRAM_ALLOWED_USER_ID=

# ---- Veiligheid ----
# DRY_RUN=true  -> bouwt en toont alles, maar plaatst NOOIT een echte bestelling.
# DRY_RUN=false -> mag na jouw goedkeuring in Telegram echt bestellen.
DRY_RUN=true
